# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Assistant API (server-side only; never use NEXT_PUBLIC_ for the key)
AI_ASSISTANT_API_URL=https://bot-voice-q52r.onrender.com/ai-assistant
AI_ASSISTANT_API_KEY=your_ai_assistant_api_key_here

# Gmail OAuth2 and email verification
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_USER_EMAIL=your_gmail_address_here
OTP_SECRET=replace_with_a_long_random_secret
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Maps (use a PUBLIC token restricted to your domain)
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token

# Telegram Configuration (if used)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
